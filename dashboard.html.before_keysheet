 cnt.forEach(function(v){if(v>mx)mx=v});
 var dots="";for(i=0;i<28;i++)dots+='<i class="'+(i===27?"t":"")+'" style="opacity:'+(cnt[i]?(0.3+0.7*cnt[i]/mx):0.12)+'"></i>';
 var list=L==="soon"?soon:gone,lh="";
